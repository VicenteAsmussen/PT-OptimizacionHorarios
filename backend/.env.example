# Plantilla exclusiva para desarrollo local, no copiar estos valores a producción.
# No versionar el archivo .env real ni reutilizar sus credenciales en el servidor.

# Servidor local
PORT=3000
NODE_ENV=development

# PostgreSQL local, las credenciales de ejemplo no son adecuadas para publicación.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/horarios_db

# Origen exacto del frontend, sin barra final ni ruta.
# En producción debe definirse explícitamente según el alojamiento confirmado.
CLIENT_URL=http://localhost:5173

# Autenticación local, duración predeterminada de ocho horas.
# En producción es obligatorio sustituir el secreto por uno aleatorio exclusivo,
# distinto del ejemplo y de al menos 32 bytes UTF-8 sin contar espacios exteriores.
# NODE_ENV=production mantiene la cookie Secure, requiere HTTPS hacia el navegador.
JWT_SECRET=supersecret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h
