# Plantilla para ejecución compilada por HTTP, sin secretos utilizables.
# Configurar externamente los valores autorizados, no copiar el .env local al servidor.

# Servidor, producción no implica HTTPS ni un modo especial de demostración.
PORT=3000
NODE_ENV=production

# Completar el destino autorizado, no se conecta al validar esta plantilla.
DATABASE_URL=

# Origen exacto del frontend, sin barra final ni ruta.
# Mismo origen para frontend compilado y /api, ajustar host y puerto del entorno.
# Solo en desarrollo con Vite: NODE_ENV=development y CLIENT_URL=http://localhost:5173.
CLIENT_URL=http://localhost:3000

# Usar un secreto aleatorio exclusivo de al menos 32 bytes UTF-8 útiles.
# Los valores vacíos se rechazan, la plantilla no sirve como credencial.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend: omitir VITE_API_URL o usar /api al compilar, nunca incluir secretos VITE_*.
# Cookie HttpOnly, Secure=false, SameSite=Lax y protección CSRF para mutaciones.
# HTTP no cifra credenciales, cookies ni datos, no presupone una red restringida.
# Instrucciones: docs/configuracion-demostracion.md.
